      "attributes": {
        "refs": "01KDEWP0MMBD164V45VZ0QCF0E"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ b ∈ B. ∃ e ∈ E. b.abstract.elem = e.id"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MM9D9AFDWMNK9F2B0G",
      "attributes": {
        "refs": "01KDEWP0MMBD164V45VZ0QCF0E"
      },
      "children": [
        {
          "type": "text",
          "value": "Binding sources reference existing elements"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MMH5RT4SDKZ0A5GC0H",
      "attributes": {
        "defName": "WF-LAYER-DEPS: Layer Dependencies",
        "refs": "01KDEWP0MMXEVMKBMVPYBEW801"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MMBXDVCG8JWQ22A10J",
      "attributes": {
        "refs": "01KDEWP0MMH5RT4SDKZ0A5GC0H"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ l ∈ L. ∀ dep ∈ l.deps. ∃ l' ∈ L. l'.id = dep"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MMJF3V34RZCG8D670K",
      "attributes": {
        "refs": "01KDEWP0MMH5RT4SDKZ0A5GC0H"
      },
      "children": [
        {
          "type": "text",
          "value": "Layer dependencies reference existing layers"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MMSPMF2SZW29FDCC0M",
      "attributes": {
        "defName": "WF-TIER-ORDER: Tier Ordering",
        "refs": "01KDEWP0MMXEVMKBMVPYBEW801"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MM9PX10WN68WZ1P70N",
      "attributes": {
        "refs": "01KDEWP0MMSPMF2SZW29FDCC0M"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ l ∈ L. ∀ dep ∈ l.deps. let l' = getLayer(dep) in pos(l') ≤ pos(l)"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MM23E8RXCR2VK8DF0P",
      "attributes": {
        "refs": "01KDEWP0MMSPMF2SZW29FDCC0M"
      },
      "children": [
        {
          "type": "text",
          "value": "Layers only depend on layers at same or higher abstraction"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
