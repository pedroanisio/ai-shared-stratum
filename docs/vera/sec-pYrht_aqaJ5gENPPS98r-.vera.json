      "attributes": {
        "refs": "01KDEWP0MM9M746BZYAGJGD50B"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ d ∈ D. ∃ e₁, e₂ ∈ E. d.src.elem = e₁.id ∧ d.tgt.elem = e₂.id"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MME52VNA459EN8H60D",
      "attributes": {
        "refs": "01KDEWP0MM9M746BZYAGJGD50B"
      },
      "children": [
        {
          "type": "text",
          "value": "Dependency endpoints reference existing elements"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MMBD164V45VZ0QCF0E",
      "attributes": {
        "defName": "WF-BINDING-SOURCE: Binding Sources",
        "refs": "01KDEWP0MMXEVMKBMVPYBEW801"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
