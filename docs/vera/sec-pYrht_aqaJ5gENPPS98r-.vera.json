    {
      "type": "containerDirective",
      "name": "section_block",
      "localId": "01KDEWP0MM4006BQ5XZV809F0X",
      "attributes": {
        "title": "Acyclicity",
        "alias": "sub-N4IBDNbvYLcD_8c4BC2NX"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MMEDAGSSXJQD06JR0Y",
      "attributes": {
        "defName": "WF-ACYCLIC-LAYERS: No Layer Cycles",
        "refs": "01KDEWP0MM4006BQ5XZV809F0X"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MMHX1KJQ8S9C5H2M0Z",
      "attributes": {
        "refs": "01KDEWP0MMEDAGSSXJQD06JR0Y"
      },
      "children": [
        {
          "type": "text",
          "value": "Let G_L = (L, {(l, l') | l' ∈ l.deps})\nG_L is acyclic"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MMCEB4MXKP1EY2V210",
      "attributes": {
        "defName": "WF-ACYCLIC-HARD: No Hard Dependency Cycles",
        "refs": "01KDEWP0MM4006BQ5XZV809F0X"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MM2EJ4AHFMV1T8FH11",
      "attributes": {
        "refs": "01KDEWP0MMCEB4MXKP1EY2V210"
      },
      "children": [
        {
          "type": "text",
          "value": "Let G_D = (E, {(e₁, e₂) | ∃d ∈ D. d.src.elem = e₁.id ∧ d.tgt.elem = e₂.id ∧ d.σ = hard})\nG_D is acyclic"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MMWY7KT42GRGWJ8Z12",
      "attributes": {
        "refs": "01KDEWP0MMCEB4MXKP1EY2V210"
      },
      "children": [
        {
          "type": "text",
          "value": "Hard dependencies must be acyclic"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MMYSWRC1SZ7W1BSG13",
      "attributes": {
        "refs": "01KDEWP0MM4006BQ5XZV809F0X"
      },
      "children": [
        {
          "type": "text",
          "value": "Note: Soft dependencies MAY form cycles (for mutual references, etc.)"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MMRR779CZ3CG2QCM14",
      "attributes": {
        "defName": "WF-SOFT-CYCLE-BOUNDED: Soft Cycle Boundaries",
        "refs": "01KDEWP0MM4006BQ5XZV809F0X"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MMQN252AMHZ3YPX215",
      "attributes": {
        "refs": "01KDEWP0MMRR779CZ3CG2QCM14"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ cycle C in G_D^soft. ∃ d ∈ C. d.cascade_boundary = ⊤\nwhere G_D^soft = (E, {(e₁, e₂) | ∃d ∈ D. d.src.elem = e₁.id ∧ d.tgt.elem = e₂.id ∧ d.σ = soft})"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MMNR6EAQB0R0X3XH16",
      "attributes": {
        "refs": "01KDEWP0MMRR779CZ3CG2QCM14"
      },
      "children": [
        {
          "type": "text",
          "value": "Every soft dependency cycle must have at least one cascade boundary to prevent infinite propagation"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MM7Y555SN4FJ3XXS17",
      "attributes": {
        "defName": "WF-CASCADE-TERMINATION: Cascade Depth Bounded",
        "refs": "01KDEWP0MM4006BQ5XZV809F0X"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MMVDDWZT97E7QQ2R18",
      "attributes": {
        "refs": "01KDEWP0MM7Y555SN4FJ3XXS17"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ r ∈ R. ∃ n ∈ ℕ. r.max_depth = n\n∀ cascade path P in impact(S, e, r). |P| ≤ r.max_depth"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MNDQAMF6JXGKJMAZ00",
      "attributes": {
        "refs": "01KDEWP0MM7Y555SN4FJ3XXS17"
      },
      "children": [
        {
          "type": "text",
          "value": "Cascade rules must specify maximum propagation depth, and all cascade paths must respect this bound"
        }
      ],
      "data": {}
    }
  ]
