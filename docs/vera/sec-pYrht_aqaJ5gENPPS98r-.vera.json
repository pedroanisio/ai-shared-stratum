      },
      "children": [
        {
          "type": "text",
          "value": "A specification S is structurally well-formed iff all of the following hold:"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MM5F9XXDW9T0DRZE03",
      "attributes": {
        "defName": "WF-ID: Unique Identifiers",
        "refs": "01KDEWP0MMXEVMKBMVPYBEW801"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MM6GYB7913Q976MT04",
      "attributes": {
        "refs": "01KDEWP0MM5F9XXDW9T0DRZE03"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ e₁, e₂ ∈ E. e₁.id = e₂.id → e₁ = e₂\n∀ l₁, l₂ ∈ L. l₁.id = l₂.id → l₁ = l₂\n∀ d₁, d₂ ∈ D. d₁.id = d₂.id → d₁ = d₂\n∀ c₁, c₂ ∈ C. c₁.id = c₂.id → c₁ = c₂\n∀ b₁, b₂ ∈ B. b₁.id = b₂.id → b₁ = b₂"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MMPBNCF4277R7ZHA05",
      "attributes": {
        "defName": "WF-LAYER: Layer Membership",
        "refs": "01KDEWP0MMXEVMKBMVPYBEW801"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MMDCJZZ4EC5B80NW06",
      "attributes": {
        "refs": "01KDEWP0MMPBNCF4277R7ZHA05"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ e ∈ E. ∃ l ∈ L. e.l = l.id"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MMXS2SMW3B3XQM6G07",
      "attributes": {
        "refs": "01KDEWP0MMPBNCF4277R7ZHA05"
      },
      "children": [
        {
          "type": "text",
          "value": "Every element belongs to a layer that exists"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MMVMWZD4SQ1B52B508",
      "attributes": {
        "defName": "WF-TYPE: Type Vocabulary",
        "refs": "01KDEWP0MMXEVMKBMVPYBEW801"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
      "localId": "01KDEWP0MMZSPYK2ZPWWS4SC09",
      "attributes": {
        "refs": "01KDEWP0MMVMWZD4SQ1B52B508"
      },
      "children": [
        {
          "type": "text",
          "value": "∀ e ∈ E. let l = layer(e) in e.τ ∈ l.T"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "para",
      "localId": "01KDEWP0MMPE0GQG2WM6EDC80A",
      "attributes": {
        "refs": "01KDEWP0MMVMWZD4SQ1B52B508"
      },
      "children": [
        {
          "type": "text",
          "value": "Every element's type is in its layer's vocabulary"
        }
      ],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "rule_def",
      "localId": "01KDEWP0MM9M746BZYAGJGD50B",
      "attributes": {
        "defName": "WF-DEP-ENDPOINTS: Dependency Endpoints",
        "refs": "01KDEWP0MMXEVMKBMVPYBEW801"
      },
      "children": [],
      "data": {}
    },
    {
      "type": "containerDirective",
      "name": "formula_block",
