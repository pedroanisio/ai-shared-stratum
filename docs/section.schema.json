{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vera.example.com/schemas/section-v1.json",
  "title": "Document Section",
  "description": "Section content node with optional children and typed content blocks",
  "$ref": "#/$defs/section",
  "$defs": {
    "blockBase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional anchor ID for deep linking"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "suffix": {
          "type": "string",
          "minLength": 1
        },
        "overview": {
          "type": "string"
        },
        "defs": {
          "type": "array",
          "description": "Local definitions scoped to this section",
          "items": {
            "$ref": "#/$defs/sectionDef"
          }
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentItem"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "sectionDefBase": {
      "type": "object",
      "description": "Base properties shared by all section definition types",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier for cross-section references"
        },
        "number": {
          "type": "string",
          "description": "Section numbering label (e.g., '16.1')"
        },
        "section": {
          "type": "string",
          "description": "Parent section reference"
        },
        "name": {
          "type": "string",
          "description": "Formal name of the definition"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "label": {
          "type": "string",
          "description": "Display label, may use referenceMap() template"
        }
      },
      "required": ["id"]
    },
    "sectionDef": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/sectionDefBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "enum" },
                "values": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Enumeration values"
                }
              },
              "required": ["kind", "values"]
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sectionDefBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "type" },
                "syntax": {
                  "type": "string",
                  "description": "Formal syntax definition"
                },
                "change_types": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of change type values"
                },
                "transform_types": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of transform type values"
                }
              },
              "required": ["kind"]
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sectionDefBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "rule" },
                "premises": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Rule premises"
                },
                "conclusion": {
                  "type": "string",
                  "description": "Rule conclusion"
                },
                "compatible_changes": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of compatible change types"
                },
                "breaking_changes": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of breaking change types"
                }
              },
              "required": ["kind", "conclusion"]
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sectionDefBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "function" },
                "signature": {
                  "type": "string",
                  "description": "Function signature"
                }
              },
              "required": ["kind", "signature"]
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sectionDefBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "theorem" },
                "conclusion": {
                  "type": "string",
                  "description": "Theorem statement"
                },
                "category": {
                  "type": "string",
                  "description": "Theorem category (e.g., 'preservation')"
                },
                "proof_sketch": {
                  "type": "string",
                  "description": "Outline of proof"
                }
              },
              "required": ["kind", "conclusion"]
            }
          ]
        },
        {
          "type": "object",
          "description": "Simple key-value definition (legacy format)",
          "additionalProperties": false,
          "required": ["id", "key", "value"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable identifier for cross-section references"
            },
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "contentItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/definitionList"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/admonition"
        },
        {
          "$ref": "#/$defs/reference"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/definition"
        },
        {
          "$ref": "#/$defs/rule"
        },
        {
          "$ref": "#/$defs/theorem"
        },
        {
          "$ref": "#/$defs/guarantee"
        },
        {
          "$ref": "#/$defs/operation"
        },
        {
          "$ref": "#/$defs/profile"
        },
        {
          "$ref": "#/$defs/checklist"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/diagram"
        },
        {
          "$ref": "#/$defs/figure"
        }
      ]
    },
    "heading": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "level",
        "text"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "type": "string",
          "description": "Plain text or Markdown inline formatting"
        }
      },
      "unevaluatedProperties": false
    },
    "paragraph": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "text": {
          "type": "string",
          "description": "Plain text or Markdown inline formatting"
        }
      },
      "unevaluatedProperties": false
    },
    "definitionList": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "definition-list"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "definition"
            ],
            "properties": {
              "term": {
                "type": "string"
              },
              "definition": {
                "type": "string",
                "description": "Plain text or Markdown inline formatting"
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "list": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "ordered": {
          "type": "boolean",
          "default": false
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/list"
              }
            ]
          }
        }
      },
      "unevaluatedProperties": false
    },
    "admonition": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "level",
        "text"
      ],
      "properties": {
        "type": {
          "const": "admonition"
        },
        "level": {
          "type": "string",
          "enum": [
            "note",
            "tip",
            "info",
            "warning",
            "danger",
            "caution",
            "important"
          ]
        },
        "text": {
          "type": "string",
          "description": "Plain text or Markdown inline formatting"
        }
      },
      "unevaluatedProperties": false
    },
    "reference": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "key",
        "citation"
      ],
      "properties": {
        "type": {
          "const": "reference"
        },
        "key": {
          "type": "string"
        },
        "rating": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "supplementary"
          ],
          "description": "Importance of this reference"
        },
        "citation": {
          "type": "string"
        },
        "use": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "code": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "lines"
      ],
      "properties": {
        "type": {
          "const": "code"
        },
        "language": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "highlight": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "definition": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "id",
        "label",
        "text"
      ],
      "properties": {
        "type": {
          "const": "definition"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier for cross-section references"
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "rule": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "label",
        "formula"
      ],
      "properties": {
        "type": {
          "const": "rule"
        },
        "label": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "theorem": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "label",
        "formula"
      ],
      "properties": {
        "type": {
          "const": "theorem"
        },
        "label": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "guarantee": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "label",
        "formula",
        "description"
      ],
      "properties": {
        "type": {
          "const": "guarantee"
        },
        "label": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "operation": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "label",
        "signature",
        "semantics"
      ],
      "properties": {
        "type": {
          "const": "operation"
        },
        "label": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "semantics": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "profile": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "label",
        "layers"
      ],
      "properties": {
        "type": {
          "const": "profile"
        },
        "label": {
          "type": "string"
        },
        "layers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "checklist": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "label",
        "items"
      ],
      "properties": {
        "type": {
          "const": "checklist"
        },
        "label": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string" },
                  "checked": { "type": "boolean", "default": false }
                }
              }
            ]
          }
        }
      },
      "unevaluatedProperties": false
    },
    "table": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "caption": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "diagram": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "format",
        "content"
      ],
      "properties": {
        "type": {
          "const": "diagram"
        },
        "format": {
          "type": "string",
          "enum": [
            "mermaid",
            "plantuml",
            "dot",
            "svg",
            "ascii"
          ]
        },
        "content": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "figure": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "src"
      ],
      "properties": {
        "type": {
          "const": "figure"
        },
        "src": {
          "type": "string",
          "description": "Image path or URI"
        },
        "alt": {
          "type": "string",
          "description": "Alt text for accessibility"
        },
        "caption": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "unevaluatedProperties": false
    }
  }
}
